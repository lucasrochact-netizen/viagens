# Chave da SerpApi (engine google_flights). https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Janela de datas monitorada
VARREDURA_IDA=2026-12-26
VARREDURA_VOLTA=2027-01-03

# Várias origens não anulam o price_insights — ver docs/varredura.md.
VARREDURA_ORIGEM=GRU,CGH,VCP

# true = price_insights de todas as regiões (14 buscas/execução); false = 8, em rodízio
VARREDURA_GATILHO_TODAS=true
VARREDURA_N_GATILHOS=1

# Fora da árvore do código, para sobreviver a clone limpo. Caminho absoluto.
VARREDURA_DATA_DIR=/home/claude-agent/.local/share/viagens/varredura

# Painel web (npm run painel). Sem autenticação: mantenha em 127.0.0.1.
PAINEL_PORT=3060
PAINEL_HOST=127.0.0.1
