[Unit]
Description=Painel da varredura de passagens (viagens)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude-agent
Group=claude-agent
WorkingDirectory=/home/claude-agent/tasks/viagens
ExecStart=/usr/bin/node src/servidor.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
